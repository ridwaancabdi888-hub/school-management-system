# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# ---- Database: Supabase PostgreSQL --------------------------------------
# From the Supabase dashboard: Project Settings -> Database -> Connection
# string -> "Transaction pooler" (URI). Use the pooler (port 6543) rather
# than the direct connection (5432) — required for serverless/Vercel, since
# each function invocation opens its own connection and the pooler is
# built for exactly that; it works fine for local dev too.
# Example shape:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_SSL=true
# Max connections this process holds open. Leave unset — server.js/local
# dev defaults to 10, Vercel serverless (detected via the VERCEL env var
# Vercel sets automatically) defaults to 1, which is what the pooler
# expects from a single serverless invocation.
# DB_POOL_MAX=

# ---- Supabase Storage (logos / student & teacher photos / gallery) ------
# Project Settings -> API. SUPABASE_SERVICE_ROLE_KEY is a secret with full
# access, bypassing Row Level Security — used server-side only, in
# utils/storage.js, to upload files. NEVER expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ---- Auth -----------------------------------------------------------------
# Secret used to sign JWTs — generate a long random string for production,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- Seed / bootstrap super admin (used by database/postgres/setup.js) ---
SUPER_ADMIN_NAME=Platform Super Admin
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@platform.local
SUPER_ADMIN_PASSWORD=SuperAdmin@123
